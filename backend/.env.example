PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smg_immobilier
DB_USER=root
DB_PASSWORD=your_password

# JWT
JWT_SECRET=smg_immobilier_super_secret_key_2024
JWT_EXPIRES_IN=7d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# Upload
MAX_FILE_SIZE=10485760

# Mobile Money — Kang Open Banking (laisser KANG_SECRET_KEY vide pour désactiver)
KANG_SECRET_KEY=
KANG_MERCHANT_ID=
KANG_WEBHOOK_SECRET=
KANG_BASE_URL=https://api.kangopenbanking.com

# Assistant IA — moteur Groq (API compatible OpenAI, palier gratuit)
# Laisser GROQ_API_KEY vide pour désactiver l'assistant (la barre se masque automatiquement).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
SMG_API_URL=http://localhost:5000/api

# Firebase / Firestore (synchro MySQL <-> Firestore)
# FIREBASE_ENABLED=true + chemin vers la clé de service JSON pour activer la synchro.
FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
FIREBASE_BACKFILL=false
